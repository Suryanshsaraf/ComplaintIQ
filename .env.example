# Backend -- copy to .env (optional; defaults work out of the box)
# SQLite (default) or PostgreSQL, e.g. postgresql+psycopg2://user:pass@localhost:5432/complaintiq
DATABASE_URL=sqlite:///backend/data/complaintiq.db
ARTIFACT_DIR=backend/artifacts
# Seed synthetic data and train models on first start if the DB is empty
AUTO_BOOTSTRAP=true
SYNTHETIC_ROWS=7000
CORS_ORIGINS=http://localhost:5173

# Frontend (frontend/.env)
VITE_API_URL=http://localhost:8000
